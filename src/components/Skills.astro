---
import { skills } from "../data/skills";
---

<section id="skills" class="skills-section">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">Tech Stack</div>
      <h2 class="section-title">Skills & Technologies</h2>
      <p class="section-description">
        A comprehensive toolkit for building modern, scalable, and
        high-performance applications
      </p>
    </div>
  </div>

  <div class="carousel-container reveal" style="animation-delay: 0.2s;">
    <div class="carousel-track">
      {
        skills.map((skill) => (
          <div class="skill-card">
            <img
              src={skill.icon}
              alt={skill.name}
              class="skill-icon"
              loading="lazy"
            />
            <div class="skill-name">{skill.name}</div>
          </div>
        ))
      }
      {/* Duplicate for infinite effect */}
      {
        skills.map((skill) => (
          <div class="skill-card">
            <img
              src={skill.icon}
              alt={skill.name}
              class="skill-icon"
              loading="lazy"
            />
            <div class="skill-name">{skill.name}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding: 8rem 0;
    position: relative;
    overflow: hidden;
  }

  .section-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .section-label {
    color: var(--accent-primary);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .section-description {
    color: var(--text-secondary);
    font-size: 1.125rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Infinite Carousel */
  .carousel-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 2rem 0;
  }

  .carousel-track {
    display: flex;
    gap: 2rem;
    animation: scroll 40s linear infinite;
    width: max-content;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .skill-card {
    background: white;
    border: 2px solid var(--border-color);
    border-radius: 20px;
    padding: 2rem 2.5rem;
    min-width: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    transition: var(--transition-smooth);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .skill-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-1);
    transform: scaleX(0);
    transition: var(--transition-smooth);
  }

  .skill-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-lg);
  }

  .skill-card:hover::before {
    transform: scaleX(1);
  }

  .skill-icon {
    width: 64px;
    height: 64px;
    object-fit: contain;
    transition: var(--transition-smooth);
  }

  .skill-card:hover .skill-icon {
    transform: scale(1.1) rotate(5deg);
  }

  .skill-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    text-align: center;
  }

  @media (max-width: 768px) {
    .skill-card {
      min-width: 150px;
      padding: 1.5rem 2.2rem;
    }
    .skill-icon {
      width: 48px;
      height: 48px;
    }
  }
</style>
